# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See docs/15-deployment-and-environment.md for what the human developer provisions
# in Azure and how these values map to it.

# --- Database (Azure Database for PostgreSQL Flexible Server) ---
# Two connection strings, two roles (docs/04-rls-security-policies.md #6):
#
# DATABASE_URL — what the running app uses. Must be the RLS-subject `app_user`
# role (created by the first migration), never the server admin — otherwise
# Row-Level Security is silently bypassed. After the first `npm run db:migrate`,
# give it a password with:  ALTER ROLE app_user PASSWORD '...';
DATABASE_URL="postgresql://app_user:CHANGE_ME@CHANGE_ME.postgres.database.azure.com:5432/cams?sslmode=require"
#
# DIRECT_DATABASE_URL — the server admin you created with the Flexible Server.
# Only Prisma Migrate and the seed script use it: migrations create tables,
# roles and SECURITY DEFINER functions, which app_user can't (and shouldn't).
DIRECT_DATABASE_URL="postgresql://CHANGE_ME_ADMIN:CHANGE_ME@CHANGE_ME.postgres.database.azure.com:5432/cams?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET="CHANGE_ME"
# Used to build OAuth callback URLs. http://localhost:3000 for local dev.
AUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID application registration ---
# See docs/05-authentication.md. The human developer creates the app registration in
# the Azure Portal (Entra ID > App registrations) and supplies these three values.
AUTH_MICROSOFT_ENTRA_ID_ID="CHANGE_ME"
AUTH_MICROSOFT_ENTRA_ID_SECRET="CHANGE_ME"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/CHANGE_ME_TENANT_ID/v2.0"

# Optional self-registration guard: if set, only accounts whose email ends in
# this domain may sign in (a plain string check in src/lib/auth/auth.ts, no
# directory lookup). Leave unset to allow any account the Entra ID app
# registration itself permits. e.g. "students.example.edu"
AUTH_ALLOWED_EMAIL_DOMAIN=""

# --- Azure Blob Storage ---
# Single generic "attachments" container. See docs/09-storage-file-management.md.
AZURE_STORAGE_CONNECTION_STRING="CHANGE_ME"
AZURE_STORAGE_ATTACHMENTS_CONTAINER="attachments"

# --- App ---
# Base URL encoded into every asset QR code (src/lib/qr.ts). Must be the real
# production origin in Azure — printed QR stickers can't be changed later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Timezone server-rendered timestamps are shown in (UTC on Azure otherwise).
APP_TIME_ZONE="Asia/Kolkata"
